{
  "name": "timesheet-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "env": "env-cmd -f .env --silent",
    "cli": "npm run env -- ts-node",
    "typeorm": "npm run env -- ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:create": "npm run typeorm -- migration:create src/db/migrations/$npm_config_name",
    "migration:generate": "npm run typeorm -- migration:generate --dataSource=src/db/config.ts src/db/migrations/$npm_config_name",
    "migration:create:win": "npm run typeorm -- migration:create src/db/migrations/%npm_config_name%",
    "migration:generate:win": "npm run typeorm -- migration:generate --dataSource=src/db/config.ts src/db/migrations/%npm_config_name%",
    "migration:revert": "npm run typeorm -- --dataSource=src/db/config.ts migration:revert",
    "migration:run": "npm run typeorm -- --dataSource=src/db/config.ts migration:run",
    "migration:run:fake": "npm run typeorm -- migration:run -f --dataSource=src/db/config.ts",
    "migration:revert:fake": "npm run typeorm -- migration:revert --dataSource=src/db/config.ts -f",
    "migration:show": "npm run typeorm -- migration:show --dataSource=src/db/config.ts",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 npm run env -- nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run env -- nest start",
    "start:dev": "npm run env -- nest start --watch",
    "start:debug": "npm run env -- nest start --debug 0.0.0.0:9228 --watch",
    "start:prod": "npm run env -- node dist/main",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"", "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    
    "test:functional": "USE_REAL_DB=1 jest --config ./test/jest-functional.json --detectOpenHandles",
    "test:functional:stubbed": "jest --config ./test/jest-functional.json --detectOpenHandles",
    "test:seed": "ts-node -r tsconfig-paths/register scripts/seed-test-data.ts",
    "env:local": "if [[ -f .env.local ]]; then cp .env .env.old && cp .env.local .env; fi",
    "env:lan": "bash scripts/env-lan.sh",
    "env:dockerremote": "if [[ -f .env.dockerremote ]]; then cp .env .env.old && cp .env.dockerremote .env; fi",
    "env:proddb": "if [[ -f .env.proddb ]]; then cp .env .env.old && cp .env.proddb .env; fi",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^8.0.0",
    "@nestjs/terminus": "^10.2.0",
    "@nestjs/throttler": "^5.1.2",
    "@nestjs/typeorm": "^10.0.2",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.2.3",
    "env-cmd": "^10.1.0",
    "joi": "^17.13.3",
    "nestjs-paginate": "^12.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "typeorm-naming-strategies": "^4.1.0",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt"
    ],
    "overrides": {
      "braces@<3.0.3": ">=3.0.3",
      "micromatch@<4.0.8": ">=4.0.8",
      "webpack@>=5.0.0-alpha.0 <5.94.0": ">=5.94.0",
      "body-parser@<1.20.3": ">=1.20.3",
      "serve-static@<1.16.0": ">=1.16.0",
      "express@<4.20.0": ">=4.20.0",
      "path-to-regexp@>=2.0.0 <3.3.0": ">=3.3.0",
      "path-to-regexp@>=0.2.0 <1.9.0": ">=1.9.0",
      "path-to-regexp@<0.1.10": ">=0.1.10",
      "@nestjs/common@<10.4.16": ">=10.4.16",
      "cookie@<0.7.0": ">=0.7.0",
      "@babel/runtime@<7.26.10": ">=7.26.10",
      "@babel/helpers@<7.26.10": ">=7.26.10",
      "cross-spawn@<6.0.6": ">=6.0.6",
      "cross-spawn@>=7.0.0 <7.0.5": ">=7.0.5",
      "multer@>=1.4.4-lts.1 <2.0.0": ">=2.0.0",
      "formidable@>=2.1.0 <2.1.3": ">=2.1.3",
      "path-to-regexp@<0.1.12": ">=0.1.12",
      "multer@>=1.4.4-lts.1 <2.0.1": ">=2.0.1",
      "brace-expansion@>=1.0.0 <=1.1.11": ">=1.1.12",
      "brace-expansion@>=2.0.0 <=2.0.1": ">=2.0.2",
      "brace-expansion@>=4.0.0": "2.0.2",
      "brace-expansion": "2.0.2",
      "multer@>=1.4.4-lts.1 <2.0.2": ">=2.0.2",
      "validator@<13.15.20": ">=13.15.20",
      "typeorm@<0.3.26": ">=0.3.26",
      "tar-fs@>=3.0.0 <3.1.1": ">=3.1.1",
      "sha.js@<=2.4.11": ">=2.4.12",
      "tmp@<=0.2.3": ">=0.2.4",
      "form-data@>=4.0.0 <4.0.4": ">=4.0.4",
      "tar-fs@>=3.0.0 <3.0.9": ">=3.0.9",
      "tar-fs@>=3.0.0 <3.0.7": ">=3.0.7",
      "send@<0.19.0": ">=0.19.0",
      "js-yaml@<4.1.1": ">=4.1.1"
    }
  }
}
